<html>
    <title>PotatoTorrent</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="shortcut icon" href="/assets/favicon.ico" type="image/x-icon">
        <link rel="icon" href="/assets/favicon.ico" type="image/x-icon">
        <script src="https://code.jquery.com/jquery-2.1.4.min.js"></script>
        <style>
            body {
                overflow-wrap: anywhere;
            }
            .item {
                justify-content: space-between;
            }
            .item:hover {
                background-color: #262626;
            }
            .loader {
                margin: auto;
                border: 2px solid #eaf0f6c9;
                border-radius: 50%;
                border-top: 2px solid #d28c41;
                width: 25px;
                height: 25px;
                animation: spinner 0.5s linear infinite;
            }

            @keyframes spinner {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
            video { width: 100%; }
        </style>
        <script src="/js/movie-listings.js"></script>
    </head>
    <body>
        <div class="container">
            <h1>PotatoTorrent</h1>
            <div class="video" style="display:none">
                <video width="640" height="360" autoplay preload controls type="video/mp4" src="" style="background:black"></video>
                <br>
                <button class="stop">Stop</button>
            </div>

            <div class="torrent-display" style="display: none; padding: 5px 15px;background: #333; border: 4px solid #d28c41;height: 80%;width: 80%;position: fixed;left: 50%;right: 50%;top: 50%;bottom: 50%;transform: translateX(-50%) translateY(-50%);box-shadow: 0 2px 15px 5px rgba(0,0,0,0.2);">
                <div style="display:flex;justify-content: space-between;align-items: center;">
                    <h2 style="color: #f1f1f1;">Torrents</h2>
                    <svg class="close-display" style="cursor:pointer;" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 26 26" xml:space="preserve" height="40" width="40">
                        <g>
                            <path d="M21.125,0H4.875C2.182,0,0,2.182,0,4.875v16.25C0,23.818,2.182,26,4.875,26h16.25   C23.818,26,26,23.818,26,21.125V4.875C26,2.182,23.818,0,21.125,0z M18.78,17.394l-1.388,1.387c-0.254,0.255-0.67,0.255-0.924,0   L13,15.313L9.533,18.78c-0.255,0.255-0.67,0.255-0.925-0.002L7.22,17.394c-0.253-0.256-0.253-0.669,0-0.926l3.468-3.467   L7.221,9.534c-0.254-0.256-0.254-0.672,0-0.925l1.388-1.388c0.255-0.257,0.671-0.257,0.925,0L13,10.689l3.468-3.468   c0.255-0.257,0.671-0.257,0.924,0l1.388,1.386c0.254,0.255,0.254,0.671,0.001,0.927l-3.468,3.467l3.468,3.467   C19.033,16.725,19.033,17.138,18.78,17.394z" style="fill:#f1f1f1;"/>
                        </g>
                    </svg>
                </div>
                <div class="results-container" style="overflow-y:scroll; height: 85%; overflow-x:hidden;">
                    <div class="loader" style="display: none;"></div>
                </div>
            </div>

            <div class="input">
                <p>Search Movie</p>
                <input type="text" style="width:350px" name="search" id="q" placeholder="Enter movie name " />
                <button class="search">Stream via Search!</button>
            </div>


            <div class="movie-display" style="width: 100%; height: 100%;">
                <div class="movie-container" style="display:flex; flex-direction: row;flex-wrap: wrap;">
                    <div class="item-container" style="padding:10px;display: flex;flex-wrap: wrap;justify-content: center;">
                    </div>
                </div>
            </div>
        </div>

        <script>
            $('.search').click(() => {
                console.log('search init');
                $('.loader').show();
                $('.torrent-display').show();
                fetch(
                    '/api/searchtorrent/' + $('#q').val()
                )
                .then(r => r.json())
                .then(torrent => {
                    $('.loader').hide();
                    for (let i=0; i < torrent.torrents.length; i++) {
                        if (document.querySelector('.results-container').children.length == 0) {
                            for (let i=0; i < document.querySelector('.results-container').children.length; i++) {
                                document.querySelector('.results-container').children[i].remove();
                            }
                        }
                        createResultItem(
                            torrent.torrents[i].torrent.title, 
                            torrent.torrents[i].torrent.seeds,
                            torrent.torrents[i].magnet
                        );
                    }
                });
            });

            $('.close-display').click(() => {
                $('.torrent-display').hide();
            });
        </script>
    </body>
</html>