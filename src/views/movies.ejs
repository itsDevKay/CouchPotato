<!DOCTYPE html>
<html lang="en" data-theme = "light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta id="tmdbID" data-tmdb-id="<%= tmdbID %>">
    <title>Watch <%= title %></title>
    <link rel="stylesheet" href="/css/output.css" type="text/css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Asap:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <style>
        .asap-font {
            font-family: "Asap", sans-serif;
            font-optical-sizing: auto;
            font-weight: 700;
            font-style: normal;
            font-variation-settings:
                "wdth" 100;
        }
        .asap-font-light {
            font-family: "Asap", sans-serif;
            font-optical-sizing: auto;
            font-weight: 200;
            font-style: normal;
            font-variation-settings:
                "wdth" 100;
        }
        .asap-font-regular {
            font-family: "Asap", sans-serif;
            font-optical-sizing: auto;
            font-weight: normal;
            font-style: normal;
            font-variation-settings:
                "wdth" 100;
        }
        .asap-font-semibold {
            font-family: "Asap", sans-serif;
            font-optical-sizing: auto;
            font-weight: 600;
            font-style: normal;
            font-variation-settings:
                "wdth" 100;
        }
    </style>
</head>
<body>
    <div class="bg-slate-900 h-screen w-full fixed -z-20">
        <div class="movie-backdrop w-full h-full bg-cover bg-no-repeat bg-center opacity-35 fixed -z-10"></div>

        <div class="flex flex-col items-center w-full h-full pt-6 px-10 justify-between lg:pt-7 lg:px-20">
            <div class="logo flex md:justify-start w-full items-center relative">
                <img src="/assets/_PotatoTorrent.png" height="42px" width="42px" />
                <div class="pl-3">
                    <p class="text-primary-white asap-font-light text-xs -mb-[5px]">Powered by</p>
                    <h3 class="text-primary-white asap-font text-2xl p-0">PotatoTorrent</h3>
                </div>

                <div class="profile absolute right-0 h-[45px] w-[45px] bg-pt-red rounded-full border-2 border-primary-white" style="box-shadow: 0 2px 5px rgba(30,34,41,35)"></div>
            </div>
            <div 
                class="bottom-container flex flex-col w-full items-center
                    md:h-[calc(100vh/2)] md:items-start
                    lg:flex-row lg:justify-between lg:items-center lg:h-[calc(100vh/1.5)]"
            >
                <div class="h-[calc(100vh/2.5)] lg:h-auto w-full mb-5 md:mb-0 md:w-full lg:w-3/5">
                    <div class="flex">
                        <!-- title -->
                        <h2 class="text-left text-primary-white text-4xl md:text-5xl lg:text-6xl asap-font drop-shadow-md">
                            <span class="title-text "></span>
                            <span class="year-text text-primary-white asap-font-light text-2xl md:text-2xl lg:text-3xl drop-shadow-sm" style="align-self: end;"></span>
                        </h2>
                    </div>

                    <!-- cast -->
                    <p class="credit-text text-left text-sm pt-2 text-primary-white asap-font-regular drop-shadow-md"></p>
                    <!-- description -->
                    <p class="description-text line-clamp-6 text-left pt-3 lg:pt-5 text-primary-white asap-font-light drop-shadow-md"></p>
                </div>

                <div class="flex flex-col">
                    <div class="flex flex-row  justify-end pr-5">
                        <div class="runtime-icon hidden lg:flex items-center" >
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" height="20" width="20">
                                <path d="M12 17V12L14.5 10.5M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="#faf7f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <p class="runtime pl-1 pr-4 runtime-estimate hidden lg:flex items-center btn text-[14px] uppercase text-right asap-font-regular text-xl justify-end cursor-pointer text-primary-white"></p>
                        <p class="rating hidden lg:flex items-center btn text-[14px] uppercase text-right asap-font-semibold text-xl justify-end cursor-pointer text-primary-white"></p>
                    </div>
                    <p class="runtime-estimate hidden lg:flex items-center btn text-[14px] asap-font-light uppercase pb-5 text-right justify-end cursor-pointer text-primary-white h-12 md:h-14 pr-3">Runtime would play till 2:46am</p>
                    <div class="flex flex-row">
                        <p class="play-trailer hidden lg:flex justify-center items-center btn asap-font tracking-wide uppercase text-base cursor-pointer text-primary-white h-12 md:h-14 pr-8">Play Trailer</p>
                        <!-- play movie lg:self-end lg:mb-[170px] -->
                        <button class="play-movie  btn uppercase text-primary-white rounded-[50px] h-12 md:h-14 w-[200px] border-2"
                        >Play Movie</button>
                    </div>
                </div>
                
                <!-- more options    -->
                <p class="text-primary-white pt-7 pb-10 asap-font-regular cursor-pointer hover:underline lg:hidden md:pl-12">More options</p>
            </div>
        </div>

        <script src="https://unpkg.com/color.js@1.2.0/dist/color.js"></script>
        <script type="module">
            import tinycolor from "https://esm.sh/tinycolor2";

            let tmdbID = document.querySelector('#tmdbID').getAttribute('data-tmdb-id');

            // fetch movie data
            fetch(`/api/movies/details/${tmdbID}`)
            .then(response => response.json())
            .then(json => {
                console.log(json);
                let data = json.details;
                let credits = json.credits;
                let coverImage = data.backdrop_path || data.backdrop_path != '' ? data.backdrop_path : data.poster_path;
                // console.log(coverImage);

                let movieBackdropDiv = document.querySelector('.movie-backdrop');
                movieBackdropDiv.style.backgroundImage = `url('https://images.tmdb.org/t/p/original${coverImage}')`;

                let titleText = document.querySelector('.title-text');
                titleText.textContent = data.title;

                let yearTitle = document.querySelector('.year-text');
                try { yearTitle.textContent = data.release_date.split('-')[0];
                } catch (e) { null; }

                let creditText = document.querySelector('.credit-text');
                creditText.textContent = (
                    `${credits.cast[0].name}, ${credits.cast[1].name}, ${credits.cast[2].name}, ${credits.cast[3].name}`
                );

                let descriptionText = document.querySelector('.description-text');
                descriptionText.textContent = data.overview;

                let runtime = document.querySelector('.runtime');
                let r = parseFloat(data.runtime /60).toFixed(2);
                let hour = Math.floor(r);
                let remainder = Number(r.toString().split('.')[1]) -60;
                // console.log(remainder)
                let min = 0;
                if (remainder > 0) {
                    hour += 1;
                    min = remainder;
                }
                runtime.textContent = `${hour}:${min}`;
                
                let rating = document.querySelector('.rating');
                rating.textContent = `${(data.vote_average * 10).toFixed(0)}%`;

                colorjs.prominent(`https://images.tmdb.org/t/p/original${coverImage}`, { amount: 20 }).then(colors => {
                    let c = [];
                    for (let i=0; i < colors.length; i++) {
                        let one = colors[i];
                        if (tinycolor(`rgb(${one[0]},${one[1]},${one[2]}`).isLight()) {
                            c = one;
                            // console.log(one);
                        } else {
                        }
                    };
                    // console.log('done');
                    // console.log(c.length);
                    if (c.length == 0) { 
                        c = colors[0]; 
                        // console.log('defaulted out') ;
                    } // default out

                    // let c = colors[2]; // [241, 221, 63]
                    /*
                        bg-[rgb(180,120,20)]
                        color: rgba(255, 255, 255, 1);
                        box-shadow: 0 5px 15px rgba(145, 92, 182, .4);
                    */
                    let playMovieBtn = document.querySelector('.play-movie');
                    playMovieBtn.style.backgroundColor = `rgba(${c[0]},${c[1]},${c[2]}`;
                    playMovieBtn.style.color = tinycolor(`rgb(${c[0]},${c[1]},${c[2]}`).isLight()
                        ? '#333' : '#faf7f7';
                    playMovieBtn.style.boxShadow =  `0 3px 15px 5px rgba(${c[0]},${c[1]},${c[2]}, .4)`;
                });
            });
        </script>
</body>
</html>