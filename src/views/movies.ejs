            <!-- movie display -->
            <div class="z-[1001] fixed iframe-containers-container h-[35%] w-10/12 md:h-[50%] md:top-[25%] lg:h-[60%] lg:top-[20%] translate-x-[50%] right-1/2 top-[35%]">
